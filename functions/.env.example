# Copy to functions/.env (gitignored). Non-secret configuration only.
#
# Secrets live in Secret Manager (production) and functions/.secret.local
# (emulator, gitignored):
#   firebase functions:secrets:set APPLE_IAP_PRIVATE_KEY < SubscriptionKey_XXXX.p8
# Never put APPLE_IAP_PRIVATE_KEY here: .env values clash with secrets on deploy.

# Google Play: defaults to the Android applicationId.
PLAY_PACKAGE_NAME=com.accountsnote.app

# App Store Connect In-App Purchase API key.
APPLE_IAP_KEY_ID=XXXXXXXXXX
APPLE_IAP_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APPLE_BUNDLE_ID=com.accountsnote.app
