migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ---- Secrets / local Firebase config (do not commit) ----
# Generate locally with: dart pub global activate flutterfire_cli && flutterfire configure
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

# Env / credentials
.env
.env.*
!.env.example
*.pem
*.p12
credentials.json
service-account*.json
firebase-adminsdk*.json

# Signing / keystores (also listed under android/.gitignore)
**/key.properties
**/*.jks
**/*.keystore
**/*.mobileprovision

# FVM / local tooling
.fvm/
.fvmrc
