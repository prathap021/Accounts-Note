rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidTransaction() {
      return request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.type in ['income', 'expense']
        && request.resource.data.categoryId is string
        && request.resource.data.date is timestamp;
    }

    // A credit card the user pays with (users/{uid}/creditCards/{cardId}):
    //   name        string, required — e.g. "HDFC Millennia"
    //   last4       string, optional — exactly four digits, nothing more
    //   color       int, required    — ARGB
    //   creditLimit number, optional — positive
    //   createdAt   timestamp, required, never changes
    //
    // The schema is closed (hasOnly) and last4 is pinned to four digits, so a
    // full card number cannot be stored in the card fields; a long digit run
    // is refused in the name for the same reason.
    //
    // createdAt is deliberately not compared to request.time: cards can be
    // added offline, and a write queued for hours would fail a recency check
    // when it finally reaches the server.
    function isValidCreditCard(card) {
      return card.keys().hasAll(['name', 'color', 'createdAt'])
        && card.keys().hasOnly(['name', 'last4', 'color', 'creditLimit', 'createdAt'])
        && card.name is string
        && card.name.trim().size() > 0
        && card.name.size() <= 100
        && !card.name.replace('[ -]', '').matches('.*[0-9]{12,}.*')
        && (card.get('last4', null) == null
            || (card.last4 is string && card.last4.matches('^[0-9]{4}$')))
        && card.color is int
        && card.color >= 0
        && card.color <= 4294967295
        && (card.get('creditLimit', null) == null
            || (card.creditLimit is number
                && card.creditLimit > 0
                && card.creditLimit < 1000000000000))
        && card.createdAt is timestamp;
    }

    // A place the user keeps money (users/{uid}/accounts/{accountId}):
    //   name           string, required, 1-100 characters
    //   kind           'cash' | 'bank' | 'upi' | 'wallet'
    //   openingBalance number, required; may be negative (overdrawn)
    //   createdAt      timestamp, required, never changes
    // Closed schema, and no account numbers: a long digit run is refused
    // in the name, as for cards.
    function isValidAccount(a) {
      return a.keys().hasAll(['name', 'kind', 'openingBalance', 'createdAt'])
        && a.keys().hasOnly(['name', 'kind', 'openingBalance', 'createdAt'])
        && a.name is string
        && a.name.trim().size() > 0
        && a.name.size() <= 100
        && !a.name.replace('[ -]', '').matches('.*[0-9]{9,}.*')
        && a.kind in ['cash', 'bank', 'upi', 'wallet']
        && a.openingBalance is number
        && a.openingBalance > -1000000000000
        && a.openingBalance < 1000000000000
        && a.createdAt is timestamp;
    }

    // Money moved between two of the user's accounts
    // (users/{uid}/transfers/{transferId}). Neither income nor expense, so
    // it has no daily counter.
    function isValidTransfer(x) {
      return x.keys().hasAll(['fromAccountId', 'toAccountId', 'fromAccountName',
          'toAccountName', 'amount', 'date', 'createdAt'])
        && x.keys().hasOnly(['fromAccountId', 'toAccountId', 'fromAccountName',
          'toAccountName', 'amount', 'date', 'note', 'createdAt'])
        && x.fromAccountId is string
        && x.toAccountId is string
        && x.fromAccountId != x.toAccountId
        && x.fromAccountName is string && x.fromAccountName.size() <= 100
        && x.toAccountName is string && x.toAccountName.size() <= 100
        && x.amount is number
        && x.amount > 0
        && x.amount < 1000000000000
        && x.date is timestamp
        && (x.get('note', null) == null
            || (x.note is string && x.note.size() <= 500))
        && x.createdAt is timestamp;
    }

    // ---- Subscriptions and daily limits -----------------------------------
    //
    // Plan fields on users/{uid}. Written only by Cloud Functions
    // (functions/src/subscriptions.ts) after the store confirms a purchase;
    // never accepted from the app.
    function subscriptionFields() {
      return [
        'subscriptionPlan',
        'subscriptionStatus',
        'subscriptionExpiresAt',
        'subscriptionAutoRenewing',
        'subscriptionPlatform',
        'subscriptionProductId',
        'subscriptionLinkId',
        'subscriptionUpdatedAt'
      ];
    }

    function subscriptionFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(subscriptionFields());
    }

    // New entries allowed per day for the user's plan: one allowance for
    // income and expense together, in any mix. A plan counts while it is active, in a payment grace
    // period, or cancelled but not yet at the end of its paid month.
    // Must match SubscriptionPlan in lib/models/subscription_plan.dart.
    function dailyLimit(uid) {
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
      let expires = user.get('subscriptionExpiresAt', null);
      let live = user.get('subscriptionStatus', '') in ['active', 'grace', 'canceled']
        && expires is timestamp
        && expires > request.time;
      let plan = live ? user.get('subscriptionPlan', 'free') : 'free';
      return {'free': 14, 'basic': 60, 'standard': 120, 'premium': 200}.get(plan, 14);
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // yyyy-MM-dd of a timestamp's UTC calendar fields.
    function dayKeyOf(ts) {
      return string(ts.year()) + '-' + pad2(ts.month()) + '-' + pad2(ts.day());
    }

    // A new entry records when it was made (createdAt) and the device's UTC
    // offset then. Entries are accepted up to 3 days late, so ones made
    // offline still upload, and backdating cannot reach further than that.
    function hasCreationStamp(tx) {
      return tx.createdAt is timestamp
        && tx.createdAt > request.time - duration.value(3, 'd')
        && tx.createdAt < request.time + duration.value(1, 'h')
        && tx.createdTzOffsetMinutes is int
        && tx.createdTzOffsetMinutes >= -720
        && tx.createdTzOffsetMinutes <= 840;
    }

    // The local day the entry counts against, as the app computes it in
    // usageDayOf() (lib/models/daily_usage.dart).
    function usageDayOf(tx) {
      return dayKeyOf(tx.createdAt + duration.value(tx.createdTzOffsetMinutes, 'm'));
    }

    // The same write must move users/{uid}/usage/{day} up by exactly one for
    // this entry's type, name this entry as lastTxId (so one bump cannot
    // cover two entries), and keep the day's total (income + expense) within
    // the plan's daily limit.
    function bumpsUsageFor(uid, txId, tx, day) {
      let path = /databases/$(database)/documents/users/$(uid)/usage/$(day);
      let before = exists(path) ? get(path).data : {};
      let after = getAfter(path).data;
      return after.lastTxId == txId
        && after.get(tx.type, 0) == before.get(tx.type, 0) + 1
        && after.get('income', 0) + after.get('expense', 0) <= dailyLimit(uid);
    }

    function isCountedNewEntry(uid, txId) {
      let tx = request.resource.data;
      return hasCreationStamp(tx)
        && bumpsUsageFor(uid, txId, tx, usageDayOf(tx));
    }

    // users/{uid}/usage/{yyyy-MM-dd}: { income, expense, lastTxId, updatedAt }.
    // Counters only ever go up, by one, for one type at a time.
    function isUsageBump(next, prev, day) {
      return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && next.keys().hasOnly(['income', 'expense', 'lastTxId', 'updatedAt'])
        && next.lastTxId is string
        && next.updatedAt == request.time
        && next.get('income', 0) is int
        && next.get('expense', 0) is int
        && (
          (next.get('income', 0) == prev.get('income', 0) + 1
            && next.get('expense', 0) == prev.get('expense', 0))
          || (next.get('expense', 0) == prev.get('expense', 0) + 1
            && next.get('income', 0) == prev.get('income', 0))
        );
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(subscriptionFields());
      allow update: if isOwner(uid) && subscriptionFieldsUnchanged();
      allow delete: if isOwner(uid);

      match /transactions/{txId} {
        // Reads/listens must not require request.resource validation.
        allow read: if isOwner(uid);
        // A new entry is accepted only alongside its day's counter bump.
        allow create: if isOwner(uid)
          && isValidTransaction()
          && isCountedNewEntry(uid, txId);
        allow update: if isOwner(uid) && isValidTransaction();
        allow delete: if isOwner(uid);
      }

      match /usage/{day} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isUsageBump(request.resource.data, {}, day);
        allow update: if isOwner(uid)
          && isUsageBump(request.resource.data, resource.data, day);
        // Never from the app: deleting a counter would hand the day's
        // allowance back.
        allow delete: if false;
      }

      match /categories/{catId} {
        allow read, write: if isOwner(uid);
      }

      match /budgets/{budgetId} {
        allow read, write: if isOwner(uid);
      }

      match /creditCards/{cardId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidCreditCard(request.resource.data);
        allow update: if isOwner(uid)
          && isValidCreditCard(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /accounts/{accountId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && isValidAccount(request.resource.data);
        allow update: if isOwner(uid)
          && isValidAccount(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /transfers/{transferId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isValidTransfer(request.resource.data);
      }

      // A receipt photo for one transaction: users/{uid}/receipts/{txId}.
      // Bytes only, under the 1 MB document limit with room to spare.
      match /receipts/{txId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['image', 'contentType', 'createdAt'])
          && request.resource.data.image is bytes
          && request.resource.data.image.size() <= 921600
          && request.resource.data.contentType in ['image/jpeg', 'image/png'];
      }

      match /recurringTransactions/{recId} {
        allow read, write: if isOwner(uid);
      }

      match /settings/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /notifications/{notifId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
